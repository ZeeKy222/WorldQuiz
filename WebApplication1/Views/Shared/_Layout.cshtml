<!DOCTYPE html>
<html lang="en" id="pageRoot">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - World Quiz</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- decorative world map background (SVG silhouette) -->
    <!-- use user-provided photo as background image; place file at wwwroot/images/world.png -->
    <div class="map-bg" aria-hidden="true"></div>
    <header>
        <div class="settings-wrapper">
            <button id="settingsToggle" class="settings-btn" aria-label="Settings">
                <img id="languageFlag" class="current-language-flag" src="https://flagcdn.com/w40/gb.png" alt="English" />
                <!-- three stacked yellow lines (hamburger-like) -->
                <span class="settings-lines" aria-hidden="true">
                    <span class="line"></span>
                    <span class="line"></span>
                    <span class="line"></span>
                </span>
            </button>

            <div id="settingsPanel" class="settings-panel" aria-hidden="true">
                <div class="settings-section">
                    <h4 data-i18n="general">General</h4>
                    <button class="settings-item" data-i18n="profile">Profile</button>
                    <button type="button" class="language-toggle" id="languageToggle">
                        <span data-i18n="language">Language</span>
                        <img id="panelLanguageFlag" src="https://flagcdn.com/w40/gb.png" alt="English" />
                    </button>
                    <div class="language-options" id="languageOptions" aria-label="Language selection">
                        <button type="button" class="language-option" data-language="en" data-flag="gb" data-label="English">
                            <img src="https://flagcdn.com/w40/gb.png" alt="English" />
                            <span data-i18n="english">English</span>
                        </button>
                        <button type="button" class="language-option" data-language="bg" data-flag="bg" data-label="Bulgarian">
                            <img src="https://flagcdn.com/w40/bg.png" alt="Български" />
                            <span data-i18n="bulgarian">Български</span>
                        </button>
                    </div>
                </div>
                <div class="settings-section">
                    <h4 data-i18n="display">Display</h4>
                    <button class="settings-item" data-i18n="theme">Theme</button>
                    <button class="settings-item" data-i18n="textSize">Text Size</button>
                </div>
                <div class="settings-section">
                    <h4 data-i18n="about">About</h4>
                    <button class="settings-item" data-i18n="version">Version</button>
                </div>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

        <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - World Quiz - <a class="text-decoration-underline text-white" data-i18n="privacy" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
